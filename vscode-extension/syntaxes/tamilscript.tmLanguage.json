{
  "scopeName": "source.tamilscript",
  "name": "TamilScript",
  "patterns": [
    {
      "name": "invalid.illegal.tamilscript",
      "match": "(?<![A-Za-z0-9_$\u0080-\uFFFF])\\$[\"']"
    },
    {
      "name": "invalid.illegal.tamilscript",
      "match": "(?<![A-Za-z0-9_$\u0080-\uFFFF])\\$[\u0BE6-\u0BEF]+(?:\\.[\u0BE6-\u0BEF]+)?n\\b"
    },
    {
      "name": "invalid.illegal.tamilscript",
      "match": "(?<![A-Za-z0-9_$\u0080-\uFFFF])\\$[\u0BE6-\u0BEF]+\\.[0-9]+"
    },
    {
      "name": "invalid.illegal.tamilscript",
      "match": "(?<![A-Za-z0-9_$\u0080-\uFFFF])\\$[\u0BE6-\u0BEF]+[A-Za-z_$0-9\u0080-\u0BE5\u0BF0-\uFFFF]"
    },
    {
      "name": "invalid.illegal.tamilscript",
      "match": "(?<![A-Za-z0-9_$\u0080-\uFFFF])\\$[\u0BE6-\u0BEF]+\\.[\u0BE6-\u0BEF]+\\.[\u0BE6-\u0BEF]+"
    },
    {
      "name": "invalid.illegal.tamilscript",
      "match": "(?<![A-Za-z0-9_$\u0080-\uFFFF])\\$[\u0BE6-\u0BEF]+\\.\\$[\u0BE6-\u0BEF]+"
    },
    {
      "name": "invalid.illegal.tamilscript",
      "match": "(?<![A-Za-z0-9_$\u0080-\uFFFF])\\$[\u0BE6-\u0BEF]+\\.[\u0BE6-\u0BEF]+\\.\\$[\u0BE6-\u0BEF]+"
    },
    {
      "name": "invalid.illegal.tamilscript",
      "match": "(?<![A-Za-z0-9_$\u0080-\uFFFF])\\$[\u0BE6-\u0BEF]+\\.[\u0BE6-\u0BEF]+[A-Za-z_$0-9\u0080-\u0BE5\u0BF0-\uFFFF]"
    },
    {
      "name": "invalid.illegal.tamilscript",
      "match": "(?<![A-Za-z0-9_$\u0080-\uFFFF])\\$[\u0BE6-\u0BEF]+\\.[\u0BE6-\u0BEF]+\\.(?![A-Za-z_$\u0080-\uFFFF\\s/\\\\])"
    },
    {
      "name": "invalid.illegal.tamilscript",
      "match": "(?<![A-Za-z0-9_$\u0080-\uFFFF])\\$\\$[\u0BE6-\u0BEF]+"
    },
    {
      "name": "constant.numeric.tamilscript",
      "match": "(?<![A-Za-z0-9_$\u0080-\uFFFF])(\\$)([\u0BE6-\u0BEF]+\\.[\u0BE6-\u0BEF]+)",
      "captures": {
        "1": { "name": "punctuation.definition.tamilscript" }
      }
    },
    {
      "name": "constant.numeric.tamilscript",
      "match": "(?<![A-Za-z0-9_$\u0080-\uFFFF])(\\$)([\u0BE6-\u0BEF]+)",
      "captures": {
        "1": { "name": "punctuation.definition.tamilscript" }
      }
    },
    { "include": "source.js" }
  ]
}
